{
  "name": "bpmn-js-example-modeler",
  "version": "0.0.0",
  "description": "A simple modeler built with bpmn-js",
  "type": "module",
  "scripts": {
    "all": "run-s build",
    "build": "webpack --mode production --config webpack.config.cjs",
    "dev": "webpack-dev-server --config webpack.config.cjs --static=public --open",
    "mcp-server": "node mcp-server/index.js",
    "start": "run-p dev mcp-server"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bpmn-io/bpmn-js-examples"
  },
  "keywords": [
    "bpmnjs-example"
  ],
  "author": {
    "name": "Nico Rehwaldt",
    "url": "https://github.com/nikku"
  },
  "contributors": [
    {
      "name": "bpmn.io contributors",
      "url": "https://github.com/bpmn-io"
    }
  ],
  "license": "MIT",
  "devDependencies": {
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.60.0",
    "raw-loader": "^4.0.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bpmn-js": "^18.12.0",
    "cors": "^2.8.6",
    "diagram-js": "^15.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jquery": "^4.0.0",
    "zod": "^4.4.3"
  }
}
